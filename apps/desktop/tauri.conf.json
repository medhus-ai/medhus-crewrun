{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrewRun",
  "version": "0.6.0",
  "identifier": "ai.medhus.crewrun",
  "build": { "frontendDist": "ui" },
  "app": { "windows": [], "withGlobalTauri": false, "security": { "capabilities": [], "csp": "default-src 'self'; frame-src 'none'; object-src 'none'" } },
  "bundle": {
